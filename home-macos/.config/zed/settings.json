// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": true,
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  // "Rosé Pine Glass" is generated by gen_zed_theme.py — Rosé Pine's foregrounds
  // on a graphite background ramp, carrying Transparent Prism's translucency
  // structure. The generator is self-contained: its key set lives in
  // zed/theme-base.json, so no theme extension needs to be installed.
  // Light stays Ayu Light.
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Rosé Pine Glass",
  },
}
