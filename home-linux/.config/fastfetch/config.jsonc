// Fastfetch — CachyOS PC. Luffy Gear 5 logo, generated by make_logo.py.
// Layout after the teal-city rice in Rice Inspirations: logo left, OS/WM/PC
// sections with tree connectors and arrows. Colors are ANSI palette refs,
// not hex, so the output follows the terminal palette — which Noctalia's
// wezterm template drives from the wallpaper.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "separator": "→ ",
    "color": {
      "output": "39",
      "separator": "90"
    }
  },
  "logo": {
    "type": "iterm",
    "source": "~/.config/fastfetch/logo.png",
    "width": 33,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "OS  ",
      "keyColor": "31",
      "format": "{name} {arch}"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "31",
      "format": "{sysname} {release}"
    },
    {
      "type": "packages",
      "key": " ├ 󰓖 ",
      "keyColor": "31"
    },
    {
      "type": "shell",
      "key": " ╰ 󰮷 ",
      "keyColor": "31",
      "format": "{pretty-name} {version}"
    },
    "break",
    {
      "type": "wm",
      "key": "WM  ",
      "keyColor": "36"
    },
    {
      "type": "theme",
      "key": " ├ 󰉌 ",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": " ├ 󰆍 ",
      "keyColor": "36",
      "format": "{pretty-name}"
    },
    {
      "type": "terminalfont",
      "key": " ╰  ",
      "keyColor": "36"
    },
    "break",
    {
      "type": "host",
      "key": "PC 󰌢 ",
      "keyColor": "34",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": " ├ 󱛠 ",
      "keyColor": "34",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": " ├ 󱚮 ",
      "keyColor": "34",
      "format": "{name}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": " ├ 󰍛 ",
      "keyColor": "34",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "34",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}",
      "folders": "/"
    },
    {
      "type": "display",
      "key": " ╰ 󰍹 ",
      "keyColor": "34",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    "break",
    {
      "type": "custom",
      "format": "  \u001b[31m● \u001b[91m● \u001b[33m● \u001b[32m● \u001b[36m● \u001b[34m● \u001b[35m● \u001b[95m●\u001b[0m"
    },
    "break"
  ]
}
